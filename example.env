# Copy to .env (never commit .env). Every variable the server reads is listed here; commented ones are optional.
# Used by docker compose, and read from the environment by the server.

# --- Mode -------------------------------------------------------------------------------------------------------
# 1 = developer mode: S3 and WhatsApp are off; the documents are the local folders (data/documents, data/users/<phone>/documents)
DEVELOPER_MODE=1

# --- The agent's Claude access: Anthropic's API, or Microsoft Foundry (CodeAgent's settings) ---------------------------
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Foundry instead: with an endpoint set, Foundry is used even if ANTHROPIC_API_KEY is set. The endpoint ends in /anthropic (no /v1/messages),
# the deployment is the name you gave it in Foundry. No API key: the agent signs in with your Microsoft account.
# ANTHROPIC_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic
# ANTHROPIC_FOUNDRY_DEPLOYMENT=claude-sonnet-5
# ANTHROPIC_FOUNDRY_API_KEY=
# What the agent may do in one question (CodeAgent's settings)
# AGENT_MAX_STEPS=100     model calls per question; the turn stops there (lower it, e.g. 15, to limit the cost of a loop)
# AGENT_WEB_SEARCH=20250305     Anthropic's hosted web search the agent uses to find pages (off to disable it)

# --- Server -----------------------------------------------------------------------------------------------------
# Protects the test page and its API. Any long random string.
WAXAL_TOKEN=change-me-to-a-long-random-string
# For WhatsApp add:  WAXAL_EXTRA_ARGS=--whatsapp
WAXAL_EXTRA_ARGS=
# WAXAL_LOG=INFO
# Agent turns of different people run in parallel, in this many processes (1: one turn at a time, in the server process)
# WAXAL_WORKERS=4
# Housekeeping at start and daily: on / off, conversations and notes kept this many days
# WAXAL_CLEANUP=on
# AGENT_CONVERSATION_DAYS=30
# AGENT_MEMORY_DAYS=90
# AGENT_MEMORY_DIR=/data/memory

# --- Language ---------------------------------------------------------------------------------------------------
# off = NO translation whatsoever: speech recognition -> the agent -> voice. The agent reads what was recognised and answers in
# WAXAL_REPLY_LANGUAGE (fr by default in this mode), and the answer is spoken as it is. ElevenLabs then recognises and speaks that language
# (ELEVENLABS_STT_LANGUAGE / ELEVENLABS_TTS_LANGUAGE are set from it unless you set them). Default on: Wolof in and out, translated.
# WAXAL_TRANSLATION=off
# The language the agent works and answers in (en, fr or wo); its text is translated into Wolof.
# wo: NO translation at all: the agent receives the Wolof as recognised, writes Wolof, and that text is spoken as it is.
# WAXAL_REPLY_LANGUAGE=en
# Only for WAXAL_STT=soynade (one call Wolof speech -> English); ElevenLabs always transcribes first, so these have no effect with it
# WAXAL_SHOW_WOLOF=0
# WAXAL_DIRECT=on

# --- Recognition (Wolof speech -> text): soynade or elevenlabs ----------------------------------------------------
# WAXAL_STT=elevenlabs  (default; or soynade)
SOYNADE_API_KEY=
# SOYNADE_BASE_URL=https://api.soynade.ai/v1
# SOYNADE_ASR_MODEL=oolel-speech-v1
# SOYNADE_ASR_LANGUAGE=wo
# SOYNADE_RETRIES=2  SOYNADE_SERVER_RETRIES=1  SOYNADE_MIN_INTERVAL=0.5  SOYNADE_COOLDOWN=60
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=
# ELEVENLABS_STT_MODEL=scribe_v1  ELEVENLABS_STT_LANGUAGE=wol  ELEVENLABS_COOLDOWN=60

# --- Translation (Wolof <-> English): claude (default) or soynade -------------------------------------------------
# WAXAL_MT=claude
# WAXAL_MT_MODEL=claude-opus-5    (on Foundry: the agent's deployment)
# Your own instructions for the Wolof translation (spelling, vocabulary, tone, a glossary, examples), read at every translation:
# (with WAXAL_REPLY_LANGUAGE=wo the agent writes the Wolof itself, and the same file is part of its instructions)
# WAXAL_TRANSLATION_STYLE=data/translation_style_prompt.md
# SOYNADE_MT_TEMPERATURE=0  SOYNADE_TRANSLATE_TEMPERATURE=0

# --- Voice (Wolof speech out): elevenlabs or soynade ---------------
# WAXAL_TTS=elevenlabs  (default)
# SOYNADE_TTS=off  (stops calling Soynade's voice)
# SOYNADE_TTS_LANGUAGE=wo
# SOYNADE_TTS_TEMPERATURE=  SOYNADE_TTS_EXAGGERATION=  SOYNADE_TTS_CFG=  SOYNADE_TTS_SEED=
# The ElevenLabs voice: the Voice ID (not the name) of a voice in your account (ElevenLabs > Voices). Default: George.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_v4  ELEVENLABS_TTS_LANGUAGE=fr
# ELEVENLABS_TTS_FORMAT=pcm_16000  (an mp3_... format is converted with ffmpeg)
# ELEVENLABS_STREAM_FORMAT=mp3_44100_64  (what POST /api/speak/stream sends, playable while it arrives)

# --- WhatsApp (Meta developer console, see docs/SANDBOX.md) -------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v21.0  (Meta Graph API version; check Meta's current one)
WHATSAPP_APP_SECRET=
# Phone numbers allowed to talk to the agent: digits only, comma-separated, country code first (no +)
WAXAL_ALLOWED=
# Phone numbers that may add documents on WhatsApp
# WAXAL_ADMINS=221771234567

# --- Links ------------------------------------------------------------------------------------------------------
# The websites the agent may share a link to (share_link: shown on the page and sent as text, never spoken), https only, a site and its
# subdomains. Not set: no link is shared. web_search (Anthropic's hosted search) lets it find the page; AGENT_WEB_SEARCH=off turns it off.
# domain=Name shows that name for the link, whatever the agent wrote (renassur.sn=Renassur); a plain domain keeps the agent's label
WAXAL_LINK_DOMAINS=renassur.sn=Renassur
# The same sites can be browsed by the agent (web_open, web_click...) to find the right page to share: uv sync --extra browser, then
# playwright install chromium (or AGENT_BROWSER_PATH=<a Chrome/Chromium/Edge executable>). No browser installed: it only shares links.
# AGENT_BROWSER_PATH=
# The most pages the agent may open (web_open) to answer one question; then it answers with what it has read. Default 3
# WAXAL_MAX_WEB_OPEN=3

# --- Instructions ---------------------------------------------------------------------------------------------
# The folder with INSTRUCTIONS.md: general instructions for the agent (the same for every person), apart from the documents. The agent
# finds the file itself with read_file. Default data/instructions
# WAXAL_INSTRUCTIONS_DIR=data/instructions

# --- Skills ----------------------------------------------------------------------------------------------------
# The folder of the agent's skills: one folder with a SKILL.md each, loaded on demand, the same for every person. Default data/skills
# WAXAL_SKILLS_DIR=data/skills

# --- Documents --------------------------------------------------------------------------------------------------
# The library shared by every person (default data/documents)
# WAXAL_DOCUMENTS=data/documents   (the Docker image sets /app/library, the folder baked in at build time)
# Docker build: the folder copied into the image as the library (default library/): LIBRARY=customers/acme/docs docker compose build
# LIBRARY=library
# WAXAL_MAX_UPLOAD_MB=20
# S3 (ignored when DEVELOPER_MODE=1): shared library at <bucket>/documents/, a person's own at <bucket>/users/<phone>/documents/
# WAXAL_S3_BUCKET=my-bucket
# AWS_ACCESS_KEY_ID=  AWS_SECRET_ACCESS_KEY=   (or a role)
# WAXAL_S3_SHARED_PREFIX=documents/  WAXAL_S3_USERS_PREFIX=users/
# WAXAL_S3_INTERVAL=600  WAXAL_S3_USER_TTL=60
# WAXAL_S3_REGION=  WAXAL_S3_ENDPOINT=
