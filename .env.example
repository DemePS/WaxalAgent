# Copy to .env (never commit .env). Used by docker compose, and read from the environment by the server.

# The agent's Claude access: your Anthropic API key (or the Foundry variables, see the CodeAgent README)
ANTHROPIC_API_KEY=sk-ant-...

# Protects the test page and its API. Any long random string.
WAXAL_TOKEN=change-me-to-a-long-random-string

# fake = stand-ins; soynade = everything through Soynade's API; soynade-asr = only its speech recognition
WAXAL_ENGINES=fake
# For WhatsApp add:  WAXAL_EXTRA_ARGS=--whatsapp
WAXAL_EXTRA_ARGS=

# Voice (Wolof speech out): soynade (their API does not offer it yet), oolel-demo (Oolel-Voices via their public demo:
# uv sync --extra demo) or huggingface (Meta MMS Wolof, non-commercial licence)
WAXAL_TTS=soynade
# For oolel-demo: a short WAV of the voice to imitate, if the demo asks for one
# WAXAL_TTS_VOICE=/app/data/voice.wav
# For WAXAL_TTS=huggingface: an access token from huggingface.co/settings/tokens
HF_TOKEN=

# Soynade's hosted API (their console): your key
SOYNADE_API_KEY=
# Optional (see `scripts/check_api.py models` for the ids your key can use):
# SOYNADE_ASR_MODEL=oolel-speech-v1
# The agent answers through speak_wolof in WAXAL_REPLY_LANGUAGE=en (en, fr or wo: the language the agent works and answers in; its text is translated into Wolof)
# Housekeeping at start and daily: WAXAL_CLEANUP=on (off to disable); AGENT_CONVERSATION_DAYS=30 AGENT_MEMORY_DAYS=90
# Voice tuning (Soynade's text-to-speech): SOYNADE_TTS_TEMPERATURE (0 = most stable), SOYNADE_TTS_EXAGGERATION, SOYNADE_TTS_CFG, SOYNADE_TTS_SEED (none is sent unless set)

# WhatsApp (Meta developer console, see docs/SANDBOX.md)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Phone numbers allowed to talk to the agent: digits only, comma-separated, country code first (no +)
WAXAL_ALLOWED=
# Translation (Wolof <-> English, and the agent's English reply -> Wolof): claude (default, the agent's own Claude) or soynade
# WAXAL_MT=claude  WAXAL_MT_MODEL=<default: claude-opus-5 (on Foundry: the agent's deployment)>
# ElevenLabs (recognition and/or voice): ELEVENLABS_API_KEY=...  WAXAL_STT=elevenlabs  WAXAL_TTS=elevenlabs
# ELEVENLABS_VOICE_ID=...  ELEVENLABS_TTS_MODEL=eleven_v4  ELEVENLABS_TTS_LANGUAGE=fr (no Wolof in eleven_v4; empty: not sent)  ELEVENLABS_STT_MODEL=scribe_v1  ELEVENLABS_STT_LANGUAGE=wol
# The library shared by every person (default data/documents) and who may add documents on WhatsApp
# WAXAL_DOCUMENTS=data/documents
# WAXAL_ADMINS=221771234567
# Documents from a Google Drive folder (instead of uploads): share the folder with the service account, then
# WAXAL_DRIVE_FOLDER=<folder id>
# WAXAL_DRIVE_CREDENTIALS=/path/to/service-account.json
# WAXAL_DRIVE_INTERVAL=600
